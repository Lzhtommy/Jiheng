# 复制为 .env 后填入真实值，.env 已在 .gitignore 中，不会被提交。

# --- Postgres ---
# 留空则使用 docker-compose.yml 自带的本地 postgres 容器（端口 5432，账号密码见下方默认值）。
# 填了就连你自己的实例（比如团队共享的开发库）。
VR_PG_HOST=
VR_PG_PORT=5432
VR_PG_DATABASE=thronepath_pg
VR_PG_USER=postgres
VR_PG_PASSWORD=postgres
JIHENG_PG_SCHEMA=jiheng

# --- 鉴权 ---
# JWT 签名密钥，Java/Python 两个服务共用，至少 32 字符
JWT_SECRET=
# 服务间内部调用的校验 token（Java InternalController / Python 均使用）
SERVICE_TOKEN=

# --- Python agent 服务 ---
# DeepSeek 官方 API key
JIHENG_DEEPSEEK_API_KEY=
# 财报 MCP（industry_research_institute/财报mcp.json 里的 Bearer token）
JIHENG_FINANCIAL_MCP_API_KEY=
